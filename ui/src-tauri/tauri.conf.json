{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bookflow Scholar",
  "version": "0.8.0-rc.2",
  "identifier": "com.bookflow.scholar.desktop",
  "build": {
    "beforeDevCommand": "corepack pnpm dev",
    "devUrl": "http://127.0.0.1:4317",
    "beforeBuildCommand": "corepack pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "title": "Bookflow Scholar",
      "width": 1440,
      "height": 940,
      "minWidth": 1120,
      "minHeight": 720,
      "resizable": true,
      "decorations": false
    }],
    "security": {"csp": null}
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": {
      "resources/bookflow-sidecar/": "bookflow-sidecar/",
      "resources/defaults/": "defaults/"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false,
        "compression": "lzma",
        "startMenuFolder": "Bookflow Scholar"
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "contract_version",
    "event_id",
    "sequence",
    "timestamp",
    "event_type",
    "project_id",
    "batch_id",
    "job_id",
    "payload"
  ],
  "properties": {
    "schema_version": {
      "const": "bookflow-event-v1.1"
    },
    "contract_version": {
      "const": "1.1.0"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "event_type": {
      "type": "string"
    },
    "payload": {
      "type": "object"
    }
  }
}
